{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts"],
    "paths": {
      "@/*": ["../*"]
    }
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
