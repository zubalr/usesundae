# Server-only Cloudflare Browser Run credentials.
# Create a token with Browser Rendering - Edit permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional stable signing secret for the 10-minute capture gate cookie. Use at
# least 32 random characters in deployed multi-instance environments.
CAPTURE_GATE_SECRET=

# Origin allowlist for deployments behind a proxy. The sponsored route requires
# an explicit production HTTPS origin; when empty, only the capture endpoint
# falls back to the origin in the incoming request URL.
# This is not authentication. Protect paid public deployments with real user
# auth, trusted-edge header handling, durable per-user budgets, and a WAF.
SUNDAE_APP_ORIGIN=

# Optional capture limiter. Missing or invalid values keep the defaults:
# 4 concurrent captures, 20 requests per 60_000ms window per client.
# For a Workers Free demo, 1 / 6 / 60000 is a burst-volume backstop. It does
# not enforce Cloudflare's separate one-Quick-Action-per-10-seconds cadence.
CAPTURE_MAX_CONCURRENT=
CAPTURE_RATE_LIMIT=
CAPTURE_RATE_WINDOW_MS=

# One sponsored evidence-backed audit per browser/network. The feature remains
# unavailable unless every value below is configured and the kill switch is true.
SPONSORED_AUDIT_ENABLED=false

# Gemini Developer API key from a billing-enabled Google AI Studio project and
# the review model.
# This is a server-only credential; never prefix it with NEXT_PUBLIC_ or expose
# it to the browser. The sponsored route uses HIGH thinking and structured JSON.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Cloudflare Turnstile widget and server verification keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public URL and shared server-to-server secret for the included Cloudflare
# Durable Object redemption gate in cloudflare/redemption-gate. The same
# secret must be stored with `wrangler secret put` for that Worker. Global
# daily-attempt and full-audit in-flight limits live as non-secret vars in
# wrangler.jsonc. They apply across all visitors and are unrelated to
# Cloudflare Browser Rendering's own concurrency.
SPONSORED_GATE_URL=
SPONSORED_GATE_SHARED_SECRET=

# At least 32 random characters. Signs the HttpOnly redemption receipt and
# one-way browser/network fingerprint; never expose this value to the client.
SPONSORED_AUDIT_SIGNING_SECRET=
