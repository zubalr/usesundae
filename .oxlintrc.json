{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "complexity": [
      "error",
      {
        "max": 55
      }
    ],
    "eslint/no-console": "warn",
    "no-control-regex": "off"
  },
  "ignorePatterns": [".next", "node_modules", "scripts"]
}
